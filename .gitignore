# Dependencies
**/node_modules/
# Python packages for fetch_rates.py (curl_cffi + certifi), installed with pip --user and moved here
# from /volume1/web/.local on 2026-09-24. Third-party code, ~31 MB, referenced by server.js's
# PYTHONPATH -- it lives on the NAS, not in git. Reinstall with:
#   pip install --user --target .python-packages/lib/python3.8/site-packages curl_cffi
.python-packages/

# Live server data (PII, secrets, runtime state)
attendance-server/backend/data/
!attendance-server/backend/data/.gitkeep

# Employee face photos. PII REMOVAL 2026-10-16 (owner's decision): emp_1..emp_10.jpg were
# tracked here and the GitHub mirror of this repo was publicly readable, so 10 real employees'
# face photos were world-readable. They are runtime data, not source: the face-scan device sync
# and the photo-upload route write them (server.js PHOTOS_DIR, which is this same folder on the
# NAS) and both mkdir it when missing, so a fresh clone needs nothing here. Untracked with
# `git rm --cached` only -- plain `git rm` would delete them off the NAS, which is the live web
# root, and every employee photo on the site would disappear.
attendance/images/employees/

# Backup snapshots
**/*.bak*
**/_backup_*/
**/__pycache__/
attendance/.git.bak-attendance-nested/

# Local tooling / tunnel binaries
attendance-server/cloudflared/
attendance-server/ngrok/
attendance-server/.npm/
attendance-server/.rnd

# Logs and debug
*.log
debug-*.log
.cursor/debug-*.log
attendance-server/watchdog.log

# Frontend local dev artifacts
attendance/.claude/
attendance/.playwright-mcp/
attendance/_backup_*/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
